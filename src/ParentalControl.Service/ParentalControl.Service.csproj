<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>exe</OutputType>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <!-- The test switches of the probe and the test hooks of SessionProbeHost exist only in a build for VM 102:
       dotnet build or publish -p:VmTest=true (compile symbol VM_TEST, design D15). build.ps1, release.yml and ci.yml
       build without it, so the release has none of them. -->
  <PropertyGroup Condition="'$(VmTest)' == 'true'">
    <DefineConstants>$(DefineConstants);VM_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ParentalControl.Core\ParentalControl.Core.csproj" />
  </ItemGroup>

  <!--
    The web admin and the child request page (web/admin, ADR 0009): a React app with two pages, index.html and
    request.html. Before the build, npm builds it into web/admin/dist, and the service embeds these files as
    resources ("AdminSpa/<path>", see Web/AdminSpa.cs and Web/RequestSpa.cs).
    - "npm ci" runs only if node_modules is missing or older than package-lock.json.
    - "npm run build" runs only if a page in dist is missing or older than a source file.
    - -p:SkipAdminSpaBuild=true skips npm, for example when CI built the bundle in an earlier step.
      The build still needs web/admin/dist.
  -->
  <PropertyGroup>
    <AdminSpaDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'web', 'admin'))</AdminSpaDir>
    <AdminSpaDist>$(AdminSpaDir)dist$([System.IO.Path]::DirectorySeparatorChar)</AdminSpaDist>
    <AdminSpaRunNpm Condition="'$(SkipAdminSpaBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">true</AdminSpaRunNpm>
  </PropertyGroup>
  <ItemGroup>
    <AdminSpaSource Include="$(AdminSpaDir)src/**/*" Exclude="$(AdminSpaDir)src/**/*.test.ts;$(AdminSpaDir)src/**/*.test.tsx;$(AdminSpaDir)src/test/**/*" />
    <AdminSpaSource Include="$(AdminSpaDir)index.html;$(AdminSpaDir)request.html;$(AdminSpaDir)package.json;$(AdminSpaDir)package-lock.json;$(AdminSpaDir)vite.config.ts;$(AdminSpaDir)tsconfig.json" />
  </ItemGroup>

  <Target Name="AdminSpaNpmCi" Condition="'$(AdminSpaRunNpm)' == 'true'"
          Inputs="$(AdminSpaDir)package-lock.json" Outputs="$(AdminSpaDir)node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(AdminSpaDir)" />
  </Target>

  <Target Name="AdminSpaBuild" DependsOnTargets="AdminSpaNpmCi" Condition="'$(AdminSpaRunNpm)' == 'true'"
          Inputs="@(AdminSpaSource)" Outputs="$(AdminSpaDist)index.html;$(AdminSpaDist)request.html">
    <Exec Command="npm run build" WorkingDirectory="$(AdminSpaDir)" />
  </Target>

  <!-- A target adds the files after npm, because a static glob reads dist before npm writes it. -->
  <Target Name="AdminSpaEmbed" BeforeTargets="PrepareForBuild" DependsOnTargets="AdminSpaBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(AdminSpaDist)index.html') or !Exists('$(AdminSpaDist)request.html')"
           Text="The web admin is not built: $(AdminSpaDist)index.html or request.html is missing. Install Node.js 22.12 or later and build without -p:SkipAdminSpaBuild=true, or run 'npm ci' and 'npm run build' in web/admin." />
    <ItemGroup>
      <_AdminSpaFile Include="$(AdminSpaDist)**/*" />
      <EmbeddedResource Include="@(_AdminSpaFile)" WithCulture="false" Type="Non-Resx"
                        LogicalName="AdminSpa/%(_AdminSpaFile.RecursiveDir)%(_AdminSpaFile.Filename)%(_AdminSpaFile.Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="ParentalControl.Tests" />
  </ItemGroup>
</Project>
